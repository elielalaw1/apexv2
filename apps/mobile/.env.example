# Optional default shown in the app's Server address field.
# For a physical iPhone, replace this example with your Mac's Wi-Fi IPv4 address.
# The iPhone and Mac must be on the same local network.
# EXPO_PUBLIC_APEX_SERVER_URL=http://192.168.1.100:3003

# In the iOS simulator, the default http://127.0.0.1:3003 works without this file.
